{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Swap-neil-spec/gatepass-verify/schema/evidence.v1.json",
  "title": "gatepass-verify evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "ok", "verificationClock", "input", "records"],
  "properties": {
    "schema": { "const": "gatepass-verify.evidence.v1" },
    "version": { "const": 1 },
    "ok": { "type": "boolean" },
    "verificationClock": { "type": "string" },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "bytes"],
      "properties": {
        "sha256": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "id",
          "format",
          "verdict",
          "label",
          "why",
          "approved",
          "approver",
          "when",
          "executed",
          "unsupported",
          "checks"
        ],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "id": { "type": ["string", "null"] },
          "format": { "type": "string" },
          "verdict": { "type": "string" },
          "label": { "type": "string" },
          "why": { "type": "string" },
          "approved": { "$ref": "#/$defs/fact" },
          "approver": { "$ref": "#/$defs/fact" },
          "when": { "$ref": "#/$defs/fact" },
          "executed": { "$ref": "#/$defs/fact" },
          "unsupported": { "type": "array", "items": { "type": "string" } },
          "checks": { "type": "array" }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "fields"],
      "properties": {
        "summary": { "type": "string" },
        "fields": { "type": "object" }
      }
    }
  }
}
