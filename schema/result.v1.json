{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Swap-neil-spec/gatepass-verify/schema/result.v1.json",
  "title": "gatepass-verify result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "ok", "records"],
  "properties": {
    "schema": { "const": "gatepass-verify.result.v1" },
    "version": { "const": 1 },
    "ok": { "type": "boolean" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "enum": ["input_too_large", "empty_input"] },
        "message": { "type": "string" }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "id", "format", "verdict", "label", "checks", "summary"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "id": { "type": ["string", "null"] },
          "format": {
            "enum": ["keel-permit", "haps", "action-v1", "afr", "ap2", "verifiable-intent", "gatepass", "unknown"]
          },
          "verdict": {
            "enum": ["valid", "tampered", "revoked", "widened", "expired", "malformed"]
          },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "ok", "detail"],
              "properties": {
                "name": { "type": "string" },
                "ok": { "type": ["boolean", "null"] },
                "detail": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
